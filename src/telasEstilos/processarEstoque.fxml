<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlers.ProcessarEstoqueController">

    <!-- TOPO -->
    <top>
        <VBox spacing="10">

            <MenuBar>
                <menus>
                    <Menu text="Home">
                        <items>
                            <MenuItem fx:id="itemInicio" text="Inicio" />
                            <MenuItem fx:id="itemSair" text="Sair" />
                        </items>
                    </Menu>

                    <Menu text="Cadastrar" fx:id="menuCadastrar">
                        <items>
                            <MenuItem fx:id="itemFuncionario" text="Funcionário" />
                            <MenuItem fx:id="itemCliente" text="Cliente" />
                            <MenuItem fx:id="itemProduto" text="Produto" />
                        </items>
                    </Menu>

                    <Menu text="Processar" fx:id="menuProcessar">
                        <items>
                            <MenuItem fx:id="itemProcessarCliente" text="Cliente" />
                        </items>
                    </Menu>

                    <Menu text="Ajuda">
                        <items>
                            <MenuItem fx:id="itemSobre" text="Sobre" />
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <Label text="Processamento de Estoque">
                <font>
                    <Font size="22" />
                </font>
            </Label>

            <!-- ÁREA DE MOVIMENTAÇÃO -->
            <GridPane hgap="10" vgap="10">

                <columnConstraints>
                    <ColumnConstraints percentWidth="25" />
                    <ColumnConstraints percentWidth="20" />
                    <ColumnConstraints percentWidth="20" />
                    <ColumnConstraints percentWidth="15" />
                    <ColumnConstraints percentWidth="20" />
                </columnConstraints>

                <!-- PRODUTO -->
                <ComboBox fx:id="cbProduto" editable="true" promptText="Buscar Produto..." GridPane.columnIndex="0" GridPane.rowIndex="0" />

                <!-- QUANTIDADE -->
                <TextField fx:id="txtQuantidade" promptText="Quantidade" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <!-- TIPO -->
                <ComboBox fx:id="cbTipo" promptText="Tipo" GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="ENTRADA" />
                            <String fx:value="SAÍDA" />
                        </FXCollections>
                    </items>
                </ComboBox>

                <!-- BOTÃO -->
                <Button fx:id="btnProcessar" onAction="#processar" text="Processar" GridPane.columnIndex="3" GridPane.rowIndex="0" />
            <rowConstraints>
               <RowConstraints />
            </rowConstraints>

            </GridPane>

            <padding>
                <Insets bottom="10" left="15" right="15" top="10" />
            </padding>
        </VBox>
    </top>

    <!-- CENTRO -->
    <center>
        <VBox spacing="10">
            <padding>
                <Insets bottom="15" left="15" right="15" top="10" />
            </padding>

            <!-- BUSCA NA TABELA -->
            <TextField fx:id="txtBuscar" promptText="Buscar movimentação..." VBox.vgrow="NEVER" />

            <!-- TABELA -->
            <TableView fx:id="tbEstoque" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="39.0" text="ID" />
                    <TableColumn fx:id="colIdProduto" prefWidth="73.0" text="ID Produto" />
                    <TableColumn fx:id="colProduto" prefWidth="89.0" text="Produto" />
                    <TableColumn fx:id="colIdFuncionario" prefWidth="119.0" text="ID Funcionário" />
                    <TableColumn fx:id="colNomeFuncionario" prefWidth="120.0" text="Nome Funcionário" />
                    <TableColumn fx:id="colQuantidade" prefWidth="88.0" text="Quantidade" />
                    <TableColumn fx:id="colTipo" prefWidth="81.0" text="Tipo" />
                    <TableColumn fx:id="colDataHora" prefWidth="95.0" text="Data/Hora" />
                </columns>
            </TableView>

        </VBox>
    </center>

</BorderPane>
