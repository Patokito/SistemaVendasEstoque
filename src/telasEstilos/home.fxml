<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlers.HomeController">

    <top>
        <VBox>

            <!-- Menu -->
            <MenuBar>
                <menus>
                    <Menu text="Home">
                        <items>
                            <MenuItem fx:id="itemSair" text="Sair" />
                        </items>
                    </Menu>

                    <Menu text="Cadastrar" fx:id="menuCadastrar">
                        <items>
                            <MenuItem fx:id="itemFuncionario" text="Funcionário" />
                            <MenuItem fx:id="itemCliente" text="Cliente" />
                            <MenuItem fx:id="itemProduto" text="Produto" />
                        </items>
                    </Menu>

                    <Menu text="Processar" fx:id="menuProcessar">
                        <items>
                            <MenuItem fx:id="itemProcessarEstoque" text="Estoque" />
                            <MenuItem fx:id="itemProcessarCliente" text="Cliente" />
                        </items>
                    </Menu>

                    <Menu text="Ajuda">
                        <items>
                            <MenuItem fx:id="itemSobre" text="Sobre" />
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <!-- Busca -->
            <HBox spacing="10">
                <padding>
                    <Insets bottom="10" left="10" right="10" top="10" />
                </padding>

                <TextField fx:id="txtBuscar" promptText="Buscar produto..." HBox.hgrow="ALWAYS" />
            </HBox>

        </VBox>
    </top>

    <center>
        <TableView fx:id="tbEstoque">
            <columns>
                <TableColumn fx:id="colid" text="ID" />
                <TableColumn fx:id="colNome" text="Nome" />
                <TableColumn fx:id="colDescricao" text="Descrição" />
                <TableColumn fx:id="colCategoria" text="Categoria" />
                <TableColumn fx:id="colPreco" text="Preço" />
                <TableColumn fx:id="colQuantidade" text="Quantidade" />
            </columns>
        </TableView>
    </center>

</BorderPane>
